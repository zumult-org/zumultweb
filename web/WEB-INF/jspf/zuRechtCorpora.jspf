<%@page import="org.zumult.objects.IDList"%>

<div id="corpora-card"
     class="card checkbox-container-card mb-3"
     style="max-width: 20rem;">

    <div class="card-header">
        <%= myResources.getString("AvailableCorpora") %>
    </div>

    <div class="card-body" id="corpus-checkbox-container">

        <%
            IDList corpusIDsForIndexing = backend.getCorporaForSearch(null);
            for (String corpusId : corpusIDsForIndexing) {
        %>

            <div class="corpora form-check">
                <input class="form-check-input"
                       name="corpus"
                       type="checkbox"
                       id="<%= corpusId %>"
                       value="<%= corpusId %>"
                       <%= corpusId.equals(corpusID) ? "checked" : "" %>
                />

                <label class="form-check-label" for="<%= corpusId %>">
                    <%= corpusId %>
                </label>
            </div>

        <% } %>

    </div>
</div>