<!-- CHANGE 03-03-2026: This was too modular for my taste, I removed some includes -->

<form id="kwic-search-form" autocomplete="off">
    <div class="input-group input-group-lg mb-3">

        <button type="button" class="btn btn-success px-3 btn-open-search-options" title="<%=myResources.getString("OpenPanelWithSearchOptions")%>">
            <span>Query </span>
        </button>


        <!-- cqp input field -->
        <input type="text" id="queryInputField" class="form-control border-success inputFieldWithAutocomplete"
               required="required" placeholder="<%=myResources.getString("SearchInputFieldPlaceholder")%> ">

        <!-- hidden search options -->
        <input type="hidden" name="pageIndex" class="pageIndex" value="0"/>
        <input type="hidden" name="pageLength" class="pageLength" value="20"/>
        <input type="hidden" name="leftContext" class="leftContext" value="3"/>
        <input type="hidden" name="rightContext" class="rightContext" value="3"/>
        <!-- changed 16-07-2025: issue #27 -->
        <input type="hidden" name="simpleQuerySyntaxLevel" class="simpleQuerySyntaxLevel" value="word"/>
        <input type="hidden" id="searchType" value="">
        <input type="hidden" name="customWordLists" class="customWordLists" value=""/>

        <!-- buttons for search, search options and search help -->
        <button type="submit" class="btn btn-success border-success" title="<%=myResources.getString("SearchBtn")%>">
            <span><i class="fa fa-search"></i></span>
        </button>
        <!-- <button type="button" class="btn border-success px-3 btn-open-search-options" title="<%=myResources.getString("OpenPanelWithSearchOptions")%>">
            <span><i class="fa fa-ellipsis-v"></i></span>
        </button> -->
    </div>

</form>
